<%- include('../partials/layout-head') %>
<div class="app">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <div class="page-header">
      <h1><%= project ? 'Edit Project' : 'New Project' %></h1>
    </div>
    <% (error || []).forEach(function(msg) { %>
      <div class="alert alert-error"><%= msg %></div>
    <% }) %>

    <div class="card">
      <form method="POST" action="<%= project ? '/projects/' + project.id + '/edit' : '/projects/new' %>">
        <div class="form-row">
          <div class="form-group">
            <label>Code *</label>
            <input name="code" placeholder="e.g. PRJ-007" required value="<%= project ? project.code : '' %>">
          </div>
          <div class="form-group">
            <label>Status</label>
            <select name="status">
              <% ['active', 'on_hold', 'completed'].forEach(function(s) { %>
                <option value="<%= s %>" <%= project && project.status === s ? 'selected' : '' %>><%= s.replace('_', ' ') %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Name *</label>
          <input name="name" required value="<%= project ? project.name : '' %>">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Client</label>
            <input name="client" value="<%= project ? project.client || '' : '' %>">
          </div>
          <div class="form-group">
            <label>Project lead</label>
            <select name="lead_id">
              <option value="">— None —</option>
              <% leads.forEach(function(l) { %>
                <option value="<%= l.id %>" <%= project && project.lead_id === l.id ? 'selected' : '' %>><%= l.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Start date</label>
            <input type="date" name="start_date" value="<%= project ? project.start_date || '' : '' %>">
          </div>
          <div class="form-group">
            <label>End date</label>
            <input type="date" name="end_date" value="<%= project ? project.end_date || '' : '' %>">
          </div>
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="3"><%= project ? project.description || '' : '' %></textarea>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn" type="submit"><%= project ? 'Save changes' : 'Create project' %></button>
          <a href="/projects<%= project ? '/' + project.id : '' %>" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>
</body></html>
