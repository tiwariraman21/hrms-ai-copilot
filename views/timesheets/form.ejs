<%- include('../partials/layout-head') %>
<div class="app">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <div class="page-header">
      <h1><%= entry ? 'Edit Time Entry' : 'Log Time' %></h1>
    </div>
    <% (error || []).forEach(function(msg) { %>
      <div class="alert alert-error"><%= msg %></div>
    <% }) %>
    <div class="card">
      <form method="POST" action="<%= entry ? '/timesheets/' + entry.id + '/edit' : '/timesheets/new' %>">
        <div class="form-row">
          <div class="form-group">
            <label>Project *</label>
            <select name="project_id" required>
              <option value="">— Select —</option>
              <% projects.forEach(function(p) { %>
                <option value="<%= p.id %>" <%= entry && entry.project_id === p.id ? 'selected' : '' %>>
                  <%= p.code %> – <%= p.name %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Date *</label>
            <input type="date" name="work_date" required value="<%= entry ? entry.work_date : '' %>">
          </div>
        </div>
        <div class="form-group">
          <label>Hours *</label>
          <input type="number" name="hours" step="0.25" min="0.25" max="24" required value="<%= entry ? entry.hours : '' %>">
        </div>
        <div class="form-group">
          <label>What did you work on?</label>
          <textarea name="task_description" rows="3"><%= entry ? entry.task_description || '' : '' %></textarea>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn" type="submit"><%= entry ? 'Save changes' : 'Save as draft' %></button>
          <a href="/timesheets" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>
</body></html>
