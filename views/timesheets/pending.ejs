<%- include('../partials/layout-head') %>
<div class="app">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <div class="page-header">
      <h1>Timesheet Approvals</h1>
    </div>
    <%- include('../partials/flash') %>

    <% if (rows.length === 0) { %>
      <div class="card empty">No timesheet entries awaiting review.</div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Employee</th><th>Date</th><th>Project</th>
            <th>Hours</th><th>Task</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r) { %>
            <tr>
              <td><%= r.name %><br><small class="muted"><%= r.department || '' %></small></td>
              <td><%= r.work_date %></td>
              <td><%= r.project_code %> – <%= r.project_name %></td>
              <td><strong><%= r.hours.toFixed(2) %></strong></td>
              <td><%= r.task_description || '—' %></td>
              <td class="row-actions">
                <form method="POST" action="/timesheets/<%= r.id %>/decide" style="display:inline;">
                  <input type="hidden" name="decision" value="approved">
                  <button class="btn btn-sm btn-success">Approve</button>
                </form>
                <form method="POST" action="/timesheets/<%= r.id %>/decide" style="display:inline;">
                  <input type="hidden" name="decision" value="rejected">
                  <button class="btn btn-sm btn-danger">Reject</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</div>
</body></html>
