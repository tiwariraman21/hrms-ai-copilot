<aside class="sidebar">

  <!-- =========================
       BRAND
  ========================== -->

  <div class="brand">

    <!-- InfraBeat Company Branding -->
    <div class="brand-logo">
      <span class="brand-infra">Infra</span><span class="brand-beat">Beat</span>
    </div>

    <!-- Application Name -->
    <div class="brand-text">
      <strong>HRMS AI</strong>
      <span>Workforce</span>
    </div>

  </div>


  <!-- =========================
       NAVIGATION
  ========================== -->

  <nav class="sidebar-nav">

    <!-- Dashboard -->

    <a
      href="/dashboard"
      class="<%= title === 'Dashboard' ? 'active' : '' %>"
    >
      <span class="nav-icon">⌂</span>
      <span class="nav-label">Dashboard</span>
    </a>


    <!-- =========================
         ORGANISATION
    ========================== -->

    <div class="nav-section">
      Organisation
    </div>

    <a href="/employees">
      <span class="nav-icon">👥</span>
      <span class="nav-label">Employees</span>
    </a>

    <% if (
      user.role === 'manager' ||
      user.role === 'admin' ||
      user.role === 'hr'
    ) { %>

      <a href="/team">

        <span class="nav-icon">
          <%= user.role === 'manager' ? '👤' : '🏢' %>
        </span>

        <span class="nav-label">
          <%= user.role === 'manager'
            ? 'My Team'
            : 'Organisation'
          %>
        </span>

      </a>

    <% } %>


    <!-- =========================
         TIME
    ========================== -->

    <div class="nav-section">
      Time
    </div>

    <a href="/attendance">

      <span class="nav-icon">
        🕒
      </span>

      <span class="nav-label">
        My Attendance
      </span>

    </a>


    <% if (
      user.role === 'admin' ||
      user.role === 'hr' ||
      user.role === 'manager'
    ) { %>

      <a href="/attendance/all">

        <span class="nav-icon">
          📊
        </span>

        <span class="nav-label">
          <%= user.role === 'manager'
            ? 'Team Attendance'
            : 'All Attendance'
          %>
        </span>

      </a>

    <% } %>


    <a href="/timesheets">

      <span class="nav-icon">
        ⏱
      </span>

      <span class="nav-label">
        My Timesheets
      </span>

    </a>


    <% if (
      user.role === 'admin' ||
      user.role === 'hr' ||
      user.role === 'manager'
    ) { %>

      <a href="/timesheets/pending">

        <span class="nav-icon">
          ✓
        </span>

        <span class="nav-label">
          Timesheet Approvals
        </span>

      </a>

    <% } %>


    <!-- =========================
         LEAVE
    ========================== -->

    <div class="nav-section">
      Leave
    </div>


    <a href="/leave">

      <span class="nav-icon">
        📅
      </span>

      <span class="nav-label">
        My Leave
      </span>

    </a>


    <% if (
      user.role === 'admin' ||
      user.role === 'hr' ||
      user.role === 'manager'
    ) { %>

      <a href="/leave/pending">

        <span class="nav-icon">
          ✓
        </span>

        <span class="nav-label">
          Leave Approvals
        </span>

      </a>

    <% } %>


    <!-- =========================
         WORK
    ========================== -->

    <div class="nav-section">
      Work
    </div>


    <a href="/projects">

      <span class="nav-icon">
        📁
      </span>

      <span class="nav-label">
        Projects
      </span>

    </a>


    <a href="/expenses">

      <span class="nav-icon">
        💳
      </span>

      <span class="nav-label">
        My Expenses
      </span>

    </a>


    <% if (
      user.role === 'admin' ||
      user.role === 'hr' ||
      user.role === 'manager'
    ) { %>

      <a href="/expenses/pending">

        <span class="nav-icon">
          ✓
        </span>

        <span class="nav-label">
          Expense Approvals
        </span>

      </a>

    <% } %>


    <!-- =========================
         ACCOUNT
    ========================== -->

    <div class="nav-section">
      Account
    </div>


    <a href="/account/password">

      <span class="nav-icon">
        ⚙
      </span>

      <span class="nav-label">
        Change Password
      </span>

    </a>

  </nav>


  <!-- =========================
       USER PROFILE
  ========================== -->

  <div class="sidebar-user">

    <div class="user-avatar">
      <%= user.name
        .split(' ')
        .map(n => n[0])
        .slice(0, 2)
        .join('')
        .toUpperCase()
      %>
    </div>


    <div class="user-details">

      <strong>
        <%= user.name %>
      </strong>

      <span>
        <%= user.email %>
      </span>

      <div class="role-tag">
        <%= user.role %>
      </div>

    </div>


    <form
      action="/logout"
      method="POST"
      class="logout-form"
    >

      <button
        type="submit"
        class="logout-btn"
        title="Log out"
      >
        ↪
      </button>

    </form>

  </div>

</aside>
