<%- include('partials/layout-head') %>

<div class="app">

  <%- include('partials/sidebar') %>

  <main class="main dashboard-main">

    <!-- =========================
         DASHBOARD HEADER
    ========================== -->

    <div class="dashboard-header">

      <div>
        <div class="dashboard-eyebrow">
          HRMS WORKSPACE
        </div>

        <h1>
          Welcome back,
          <%= user.name.split(' ')[0] %> 👋
        </h1>

        <p class="dashboard-subtitle">
          Here's what's happening in your workspace today.
        </p>
      </div>

      <div class="dashboard-date-card">

        <div class="date-icon">
          📅
        </div>

        <div>
          <div class="date-label">
            TODAY
          </div>

          <div class="date-value">
            <%= new Date().toLocaleDateString(
              'en-US',
              {
                weekday: 'short',
                day: 'numeric',
                month: 'short',
                year: 'numeric'
              }
            ) %>
          </div>
        </div>

      </div>

    </div>


    <!-- =========================
         KPI GRID
    ========================== -->

    <div class="stat-grid dashboard-stat-grid">

      <% if (user.role === 'manager') { %>

        <div class="stat-card stat-primary">
          <div class="stat-top">
            <div class="stat-icon">👥</div>
            <span class="stat-tag">TEAM</span>
          </div>

          <div class="label">My Team</div>
          <div class="value"><%= stats.teamSize %></div>

          <div class="stat-description">
            Direct team members
          </div>
        </div>

      <% } else { %>

        <div class="stat-card stat-primary">
          <div class="stat-top">
            <div class="stat-icon">👥</div>
            <span class="stat-tag">HRMS</span>
          </div>

          <div class="label">Employees</div>
          <div class="value"><%= stats.empCount %></div>

          <div class="stat-description">
            Total employees
          </div>
        </div>

      <% } %>


      <!-- Attendance -->

      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon stat-icon-blue">🕒</div>
          <span class="stat-tag">TODAY</span>
        </div>

        <div class="label">Clocked In</div>

        <div class="value">
          <%= stats.todayAttendance %>
        </div>

        <div class="stat-description">
          Employees clocked in
        </div>
      </div>


      <!-- Leave -->

      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon stat-icon-orange">📅</div>

          <% if (stats.pendingLeave > 0) { %>
            <span class="stat-status warning">ACTION</span>
          <% } else { %>
            <span class="stat-status success">CLEAR</span>
          <% } %>
        </div>

        <div class="label">Pending Leave</div>

        <div class="value">
          <%= stats.pendingLeave %>
        </div>

        <div class="stat-description">
          Requests awaiting review
        </div>
      </div>


      <!-- Expenses -->

      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon stat-icon-green">💰</div>

          <% if (stats.pendingExpenses > 0) { %>
            <span class="stat-status warning">ACTION</span>
          <% } else { %>
            <span class="stat-status success">CLEAR</span>
          <% } %>
        </div>

        <div class="label">Pending Expenses</div>

        <div class="value">
          <%= stats.pendingExpenses %>
        </div>

        <div class="stat-description">
          Claims awaiting approval
        </div>
      </div>


      <!-- Timesheets -->

      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon stat-icon-purple">⏱</div>

          <% if (stats.pendingTimesheets > 0) { %>
            <span class="stat-status warning">ACTION</span>
          <% } else { %>
            <span class="stat-status success">CLEAR</span>
          <% } %>
        </div>

        <div class="label">Pending Timesheets</div>

        <div class="value">
          <%= stats.pendingTimesheets %>
        </div>

        <div class="stat-description">
          Timesheets awaiting review
        </div>
      </div>


      <!-- Projects -->

      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon stat-icon-indigo">📁</div>
          <span class="stat-tag">WORK</span>
        </div>

        <div class="label">My Projects</div>

        <div class="value">
          <%= stats.myProjects %>
        </div>

        <div class="stat-description">
          Active project allocations
        </div>
      </div>


      <!-- Leave Balance -->

      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon stat-icon-teal">🌿</div>
          <span class="stat-tag">BALANCE</span>
        </div>

        <div class="label">Leave Balance</div>

        <div class="value">
          <%= myBalance %>
        </div>

        <div class="stat-description">
          Available leave days
        </div>
      </div>

    </div>


    <!-- =========================
         AI COPILOT SUMMARY
    ========================== -->

    <div class="ai-dashboard-card">

      <div class="ai-dashboard-header">

        <div class="ai-title-group">

          <div class="ai-dashboard-icon">
            ✨
          </div>

          <div>
            <div class="ai-dashboard-label">
              AI COPILOT
            </div>

            <h2>
              Your intelligent HRMS assistant
            </h2>

            <p>
              Get insights, answer questions and complete HR tasks using natural language.
            </p>
          </div>

        </div>

        <button
          type="button"
          class="ai-open-btn"
          onclick="document.getElementById('ai-chat-button').click()"
        >
          Open Copilot
          <span>→</span>
        </button>

      </div>

      <div class="ai-insights-grid">

        <% if (insights && insights.length > 0) { %>

          <% insights.slice(0, 3).forEach((insight, index) => { %>

            <div class="ai-insight-modern">

              <div class="ai-insight-number">
                0<%= index + 1 %>
              </div>

              <div class="ai-insight-content">
                <span class="ai-insight-label">
                  AI INSIGHT
                </span>

                <p>
                  <%= insight %>
                </p>
              </div>

            </div>

          <% }) %>

        <% } else { %>

          <div class="ai-empty-state">
            <span>✨</span>
            <div>
              <strong>Everything looks good.</strong>
              <p>
                No important issues require your attention right now.
              </p>
            </div>
          </div>

        <% } %>

      </div>

    </div>


    <!-- =========================
         TWO COLUMN WORKSPACE
    ========================== -->

    <div class="dashboard-two-column">


      <!-- =========================
           MY DAY
      ========================== -->

      <div class="card dashboard-card">

        <div class="section-heading">

          <div>
            <span class="section-eyebrow">
              TODAY
            </span>

            <h2>My Day</h2>
          </div>

          <div class="section-icon">
            ☀️
          </div>

        </div>


        <% if (myToday && myToday.clock_in) { %>

          <div class="attendance-status active">

            <div class="status-dot"></div>

            <div>

              <strong>
                You're clocked in
              </strong>

              <p>
                Started at
                <strong><%= myToday.clock_in %></strong>

                <% if (myToday.clock_out) { %>
                  · Finished at
                  <strong><%= myToday.clock_out %></strong>
                <% } %>
              </p>

            </div>

          </div>

        <% } else { %>

          <div class="attendance-status">

            <div class="status-dot inactive"></div>

            <div>

              <strong>
                You haven't clocked in yet
              </strong>

              <p>
                Start your workday from the attendance section.
              </p>

            </div>

          </div>

        <% } %>


        <div class="quick-action-grid">

          <a href="/attendance" class="quick-action">

            <span>🕒</span>

            <div>
              <strong>Attendance</strong>
              <small>Clock in / out</small>
            </div>

          </a>


          <a href="/timesheets/new" class="quick-action">

            <span>⏱</span>

            <div>
              <strong>Log Time</strong>
              <small>Record working hours</small>
            </div>

          </a>


          <a href="/leave/new" class="quick-action">

            <span>📅</span>

            <div>
              <strong>Apply Leave</strong>
              <small>Submit a leave request</small>
            </div>

          </a>


          <a href="/expenses/new" class="quick-action">

            <span>💳</span>

            <div>
              <strong>Expense</strong>
              <small>Submit a claim</small>
            </div>

          </a>

        </div>

      </div>


      <!-- =========================
           ROLE ACTIONS
      ========================== -->

      <div class="card dashboard-card">

        <div class="section-heading">

          <div>
            <span class="section-eyebrow">
              WORKSPACE
            </span>

            <h2>Quick Actions</h2>
          </div>

          <div class="section-icon">
            ⚡
          </div>

        </div>


        <% if (user.role === 'admin' || user.role === 'hr') { %>

          <div class="role-action-list">

            <a href="/employees/new" class="role-action primary-action">
              <span>👤</span>
              <div>
                <strong>Add Employee</strong>
                <small>Create a new employee</small>
              </div>
              <span class="arrow">→</span>
            </a>


            <a href="/projects/new" class="role-action">
              <span>📁</span>
              <div>
                <strong>New Project</strong>
                <small>Create a project</small>
              </div>
              <span class="arrow">→</span>
            </a>


            <a href="/leave/pending" class="role-action">
              <span>📅</span>
              <div>
                <strong>Review Leave</strong>
                <small>Review pending requests</small>
              </div>
              <span class="arrow">→</span>
            </a>


            <a href="/expenses/pending" class="role-action">
              <span>💰</span>
              <div>
                <strong>Review Expenses</strong>
                <small>Approve expense claims</small>
              </div>
              <span class="arrow">→</span>
            </a>


            <a href="/timesheets/pending" class="role-action">
              <span>⏱</span>
              <div>
                <strong>Review Timesheets</strong>
                <small>Approve submitted hours</small>
              </div>
              <span class="arrow">→</span>
            </a>

          </div>


        <% } else if (user.role === 'manager') { %>

          <div class="role-action-list">

            <a href="/team" class="role-action primary-action">

              <span>👥</span>

              <div>
                <strong>My Team</strong>
                <small>View team members</small>
              </div>

              <span class="arrow">→</span>

            </a>


            <a href="/projects/new" class="role-action">

              <span>📁</span>

              <div>
                <strong>New Project</strong>
                <small>Create a project</small>
              </div>

              <span class="arrow">→</span>

            </a>


            <a href="/leave/pending" class="role-action">

              <span>📅</span>

              <div>
                <strong>Approve Leave</strong>
                <small>Review team requests</small>
              </div>

              <span class="arrow">→</span>

            </a>


            <a href="/expenses/pending" class="role-action">

              <span>💰</span>

              <div>
                <strong>Approve Expenses</strong>
                <small>Review team claims</small>
              </div>

              <span class="arrow">→</span>

            </a>


            <a href="/timesheets/pending" class="role-action">

              <span>⏱</span>

              <div>
                <strong>Approve Timesheets</strong>
                <small>Review submitted hours</small>
              </div>

              <span class="arrow">→</span>

            </a>

          </div>


        <% } else { %>

          <div class="employee-ai-prompt">

            <div class="employee-ai-icon">
              ✨
            </div>

            <strong>
              Let AI handle your HR tasks
            </strong>

            <p>
              Try asking the AI Copilot:
            </p>

            <div class="prompt-example">
              "Apply leave for tomorrow"
            </div>

            <div class="prompt-example">
              "How many hours did I work?"
            </div>

            <div class="prompt-example">
              "Submit my travel expense"
            </div>

          </div>

        <% } %>

      </div>

    </div>
<!-- =========================
     WORKFORCE ANALYTICS
========================== -->

<div class="analytics-section">

  <div class="analytics-heading">

    <div>

      <span class="section-eyebrow">
        ANALYTICS
      </span>

      <h2>Workforce Overview</h2>

      <p>
        A quick view of recent HRMS activity.
      </p>

    </div>

  </div>


  <div class="analytics-grid">

    <!-- Attendance -->

    <div class="card analytics-card">

      <div class="analytics-card-header">

        <div>

          <span class="analytics-label">
            ATTENDANCE
          </span>

          <h3>7-Day Attendance Trend</h3>

        </div>

        <div class="analytics-icon">
          📈
        </div>

      </div>

      <div class="chart-container">

        <canvas id="attendanceChart"></canvas>

      </div>

    </div>


    <!-- Leave -->

    <div class="card analytics-card">

      <div class="analytics-card-header">

        <div>

          <span class="analytics-label">
            LEAVE
          </span>

          <h3>Leave Overview</h3>

        </div>

        <div class="analytics-icon">
          📅
        </div>

      </div>

      <div class="chart-container chart-small">

        <canvas id="leaveChart"></canvas>

      </div>

    </div>


    <!-- Expenses -->

    <div class="card analytics-card">

      <div class="analytics-card-header">

        <div>

          <span class="analytics-label">
            EXPENSES
          </span>

          <h3>Expense Status</h3>

        </div>

        <div class="analytics-icon">
          💰
        </div>

      </div>

      <div class="chart-container chart-small">

        <canvas id="expenseChart"></canvas>

      </div>

    </div>


    <!-- Recent Activity -->

    <div class="card analytics-card">

      <div class="analytics-card-header">

        <div>

          <span class="analytics-label">
            ACTIVITY
          </span>

          <h3>Recent Activity</h3>

        </div>

        <div class="analytics-icon">
          ⚡
        </div>

      </div>

      <div class="activity-list">

        <% if (
          analytics.recentActivity &&
          analytics.recentActivity.length
        ) { %>

          <% analytics.recentActivity.forEach(activity => { %>

            <div class="activity-item">

              <div class="activity-dot"></div>

              <div class="activity-content">

                <strong>
                  <%= activity.employee_name %>
                </strong>

                <span>
                  <%= activity.activity_type %>
                </span>

              </div>

              <div class="activity-status">

                <span class="badge badge-status-<%= activity.status %>">

                  <%= activity.status %>

                </span>

              </div>

            </div>

          <% }) %>

        <% } else { %>

          <div class="empty">

            No recent activity.

          </div>

        <% } %>

      </div>

    </div>

  </div>

</div>

  </main>

</div>


<!-- =========================
     AI CHAT COMPONENT
========================= -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</body>
</html>
