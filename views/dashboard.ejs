<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> | HRMS</title>

    <link
        rel="stylesheet"
        href="/styles.css"
    >

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>


<body>

<div class="app">

    <!-- =========================
         SIDEBAR
    ========================== -->

    <%- include('partials/sidebar') %>


    <!-- =========================
         MAIN CONTENT
    ========================== -->

    <main class="main">


        <!-- =========================
             PAGE HEADER
        ========================== -->

        <div class="page-header">

            <div>

                <span class="section-eyebrow">
                    DASHBOARD
                </span>

                <h1>

                    Welcome,

                    <%= user.name %>

                </h1>

                <p class="muted">

                    Here's an overview of your workspace.

                </p>

            </div>

        </div>


        <!-- =========================
             KPI CARDS
        ========================== -->

        <div class="stat-grid">

            <div class="stat-card">

                <div class="label">
                    Employees
                </div>

                <div class="value">
                    <%= stats.empCount %>
                </div>

            </div>


            <div class="stat-card">

                <div class="label">
                    Today's Attendance
                </div>

                <div class="value">
                    <%= stats.todayAttendance %>
                </div>

            </div>


            <div class="stat-card">

                <div class="label">
                    Pending Leave
                </div>

                <div class="value">
                    <%= stats.pendingLeave %>
                </div>

            </div>


            <% if (stats.teamSize !== null) { %>

                <div class="stat-card">

                    <div class="label">
                        Team Size
                    </div>

                    <div class="value">
                        <%= stats.teamSize %>
                    </div>

                </div>

            <% } else { %>

                <div class="stat-card">

                    <div class="label">
                        My Projects
                    </div>

                    <div class="value">
                        <%= stats.myProjects %>
                    </div>

                </div>

            <% } %>


            <div class="stat-card">

                <div class="label">
                    Pending Expenses
                </div>

                <div class="value">
                    <%= stats.pendingExpenses %>
                </div>

            </div>


            <div class="stat-card">

                <div class="label">
                    Pending Timesheets
                </div>

                <div class="value">
                    <%= stats.pendingTimesheets %>
                </div>

            </div>

        </div>


        <!-- =========================
             TWO COLUMN DASHBOARD
        ========================== -->

        <div class="dashboard-two-column">


            <!-- =========================
                 LEFT COLUMN
            ========================== -->

            <div>


                <!-- =========================
                     MY DAY
                ========================== -->

                <div class="card">

                    <h2>
                        My Day
                    </h2>


                    <% if (myToday) { %>

                        <div class="profile-grid">

                            <dt>
                                Clock In
                            </dt>

                            <dd>
                                <%= myToday.clock_in || '-' %>
                            </dd>


                            <dt>
                                Clock Out
                            </dt>

                            <dd>
                                <%= myToday.clock_out || '-' %>
                            </dd>


                            <dt>
                                Status
                            </dt>

                            <dd>

                                <span class="badge badge-approved">

                                    Present

                                </span>

                            </dd>

                        </div>

                    <% } else { %>

                        <div class="empty">

                            No attendance recorded today.

                        </div>

                    <% } %>

                </div>


                <!-- =========================
                     LEAVE BALANCE
                ========================== -->

                <div class="card">

                    <h2>
                        Leave Balance
                    </h2>

                    <div class="stat-card">

                        <div class="label">
                            Available Leave
                        </div>

                        <div class="value">
                            <%= myBalance %>
                        </div>

                    </div>

                </div>


                <!-- =========================
                     AI INSIGHTS
                ========================== -->

                <div class="card ai-insights-card">

                    <h2>
                        🤖 AI Insights
                    </h2>


                    <% if (
                        insights &&
                        insights.length
                    ) { %>


                        <% insights.forEach(insight => { %>

                            <div class="insight-item">

                                <%= insight %>

                            </div>

                        <% }) %>


                    <% } else { %>

                        <div class="empty">

                            No AI insights available.

                        </div>

                    <% } %>

                </div>

            </div>


            <!-- =========================
                 RIGHT COLUMN
            ========================== -->

            <div>


                <!-- =========================
                     QUICK ACTIONS
                ========================== -->

                <div class="card">

                    <h2>
                        Quick Actions
                    </h2>


                    <div
                        style="
                            display:grid;
                            grid-template-columns:1fr 1fr;
                            gap:12px;
                        "
                    >

                        <a
                            href="/attendance"
                            class="btn"
                        >
                            Attendance
                        </a>


                        <a
                            href="/leave"
                            class="btn"
                        >
                            Leave
                        </a>


                        <a
                            href="/expenses"
                            class="btn"
                        >
                            Expenses
                        </a>


                        <a
                            href="/timesheets"
                            class="btn"
                        >
                            Timesheets
                        </a>

                    </div>

                </div>


                <!-- =========================
                     ACCOUNT
                ========================== -->

                <div class="card">

                    <h2>
                        My Account
                    </h2>


                    <dl class="profile-grid">

                        <dt>
                            Name
                        </dt>

                        <dd>
                            <%= user.name %>
                        </dd>


                        <dt>
                            Email
                        </dt>

                        <dd>
                            <%= user.email %>
                        </dd>


                        <dt>
                            Role
                        </dt>

                        <dd>

                            <span
                                class="badge badge-<%= user.role %>"
                            >

                                <%= user.role %>

                            </span>

                        </dd>

                    </dl>

                </div>

            </div>

        </div>


        <!-- =========================
             WORKFORCE ANALYTICS
        ========================== -->

        <div class="analytics-section">

            <div class="analytics-heading">

                <div>

                    <span class="section-eyebrow">
                        ANALYTICS
                    </span>

                    <h2>
                        Workforce Overview
                    </h2>

                    <p>
                        A quick overview of workforce
                        activity and trends.
                    </p>

                </div>

            </div>


            <div class="analytics-grid">


                <!-- =========================
                     ATTENDANCE
                ========================== -->

                <div class="card analytics-card">

                    <div class="analytics-card-header">

                        <div>

                            <span class="analytics-label">
                                ATTENDANCE
                            </span>

                            <h3>
                                7-Day Attendance Trend
                            </h3>

                        </div>

                        <div class="analytics-icon">
                            📈
                        </div>

                    </div>


                    <div class="chart-container">

                        <canvas
                            id="attendanceChart"
                        ></canvas>

                    </div>

                </div>


                <!-- =========================
                     LEAVE
                ========================== -->

                <div class="card analytics-card">

                    <div class="analytics-card-header">

                        <div>

                            <span class="analytics-label">
                                LEAVE
                            </span>

                            <h3>
                                Leave Overview
                            </h3>

                        </div>

                        <div class="analytics-icon">
                            📅
                        </div>

                    </div>


                    <div class="chart-container chart-small">

                        <canvas
                            id="leaveChart"
                        ></canvas>

                    </div>

                </div>


                <!-- =========================
                     EXPENSE
                ========================== -->

                <div class="card analytics-card">

                    <div class="analytics-card-header">

                        <div>

                            <span class="analytics-label">
                                EXPENSES
                            </span>

                            <h3>
                                Expense Status
                            </h3>

                        </div>

                        <div class="analytics-icon">
                            💰
                        </div>

                    </div>


                    <div class="chart-container chart-small">

                        <canvas
                            id="expenseChart"
                        ></canvas>

                    </div>

                </div>


                <!-- =========================
                     PROJECT OVERVIEW
                ========================== -->

                <div class="card analytics-card">

                    <div class="analytics-card-header">

                        <div>

                            <span class="analytics-label">
                                PROJECTS
                            </span>

                            <h3>
                                Project Overview
                            </h3>

                        </div>

                        <div class="analytics-icon">
                            📁
                        </div>

                    </div>


                    <div class="project-list">


                        <% if (
                            analytics &&
                            analytics.projectOverview &&
                            analytics.projectOverview.length
                        ) { %>


                            <% analytics.projectOverview.forEach(project => { %>

                                <div class="project-item">


                                    <div class="project-main">

                                        <strong>
                                            <%= project.name %>
                                        </strong>


                                        <span class="project-code">

                                            <%= project.code %>


                                            <% if (project.client) { %>

                                                · <%= project.client %>

                                            <% } %>

                                        </span>

                                    </div>


                                    <div class="project-meta">


                                        <span
                                            class="badge badge-status-<%= project.status %>"
                                        >

                                            <%= project.status.replace('_', ' ') %>

                                        </span>


                                        <% if (
                                            user.role === 'employee' &&
                                            project.allocation_percent != null
                                        ) { %>

                                            <span class="project-allocation">

                                                <%= project.allocation_percent %>%

                                            </span>

                                        <% } %>


                                        <% if (
                                            user.role === 'hr' ||
                                            user.role === 'admin'
                                        ) { %>

                                            <span class="project-allocation">

                                                <%= project.team_size %>

                                                member<%= project.team_size === 1 ? '' : 's' %>

                                            </span>

                                        <% } %>


                                    </div>

                                </div>

                            <% }) %>


                        <% } else { %>


                            <div class="empty">

                                No projects available.

                            </div>


                        <% } %>


                    </div>

                </div>


                <!-- =========================
                     RECENT ACTIVITY
                ========================== -->

                <div class="card analytics-card">

                    <div class="analytics-card-header">

                        <div>

                            <span class="analytics-label">
                                ACTIVITY
                            </span>

                            <h3>
                                Recent Activity
                            </h3>

                        </div>

                        <div class="analytics-icon">
                            ⚡
                        </div>

                    </div>


                    <div class="activity-list">


                        <% if (
                            analytics &&
                            analytics.recentActivity &&
                            analytics.recentActivity.length
                        ) { %>


                            <% analytics.recentActivity.forEach(activity => { %>

                                <div class="activity-item">

                                    <div class="activity-dot"></div>


                                    <div class="activity-content">

                                        <strong>

                                            <%= activity.employee_name %>

                                        </strong>

                                        <span>

                                            <%= activity.activity_type %>

                                        </span>

                                    </div>


                                    <div class="activity-status">

                                        <span
                                            class="badge badge-status-<%= activity.status %>"
                                        >

                                            <%= activity.status %>

                                        </span>

                                    </div>

                                </div>

                            <% }) %>


                        <% } else { %>


                            <div class="empty">

                                No recent activity.

                            </div>


                        <% } %>


                    </div>

                </div>

            </div>

        </div>


        <!-- =========================
             AI CHAT COMPONENT
        ========================== -->

        <%- include('partials/ai-chat') %>


    </main>

</div>


<!-- =========================
     SCRIPTS
========================== -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="/ai-chat.js"></script>


<script>

document.addEventListener(
    'DOMContentLoaded',
    function () {


        /* =====================================================
           DATA FROM SERVER
        ===================================================== */

        const attendanceData =
            <%- JSON.stringify(
                analytics?.attendanceTrend || []
            ) %>;


        const leaveData =
            <%- JSON.stringify(
                analytics?.leaveOverview || []
            ) %>;


        const expenseData =
            <%- JSON.stringify(
                analytics?.expenseOverview || []
            ) %>;


        /* =====================================================
           ATTENDANCE CHART
        ===================================================== */

        const attendanceCanvas =
            document.getElementById(
                'attendanceChart'
            );


        if (
            attendanceCanvas &&
            attendanceData.length > 0
        ) {


            new Chart(
                attendanceCanvas,
                {

                    type: 'line',

                    data: {

                        labels:
                            attendanceData.map(
                                item => item.date
                            ),

                        datasets: [{

                            label:
                                'Employees',

                            data:
                                attendanceData.map(
                                    item => item.count
                                ),

                            borderColor:
                                '#4F46E5',

                            backgroundColor:
                                'rgba(79,70,229,.12)',

                            fill:
                                true,

                            tension:
                                0.4,

                            pointRadius:
                                4,

                            pointHoverRadius:
                                6,

                            borderWidth:
                                3

                        }]

                    },


                    options: {

                        responsive:
                            true,

                        maintainAspectRatio:
                            false,


                        plugins: {

                            legend: {

                                display:
                                    false

                            }

                        },


                        scales: {


                            x: {

                                grid: {

                                    display:
                                        false

                                }

                            },


                            y: {

                                beginAtZero:
                                    true,

                                ticks: {

                                    precision:
                                        0

                                }

                            }

                        }

                    }

                }
            );

        }


        /* =====================================================
           LEAVE CHART
        ===================================================== */

        const leaveCanvas =
            document.getElementById(
                'leaveChart'
            );


        if (
            leaveCanvas &&
            leaveData.length > 0
        ) {


            new Chart(
                leaveCanvas,
                {

                    type:
                        'doughnut',


                    data: {

                        labels:
                            leaveData.map(
                                item => item.status
                            ),


                        datasets: [{

                            data:
                                leaveData.map(
                                    item => item.count
                                ),

                            backgroundColor: [

                                '#4F46E5',

                                '#16A34A',

                                '#F59E0B',

                                '#DC2626'

                            ],

                            borderWidth:
                                0

                        }]

                    },


                    options: {

                        responsive:
                            true,

                        maintainAspectRatio:
                            false,

                        cutout:
                            '65%',


                        plugins: {

                            legend: {

                                position:
                                    'bottom'

                            }

                        }

                    }

                }
            );

        }


        /* =====================================================
           EXPENSE CHART
        ===================================================== */

        const expenseCanvas =
            document.getElementById(
                'expenseChart'
            );


        if (
            expenseCanvas &&
            expenseData.length > 0
        ) {


            new Chart(
                expenseCanvas,
                {

                    type:
                        'doughnut',


                    data: {

                        labels:
                            expenseData.map(
                                item => item.status
                            ),


                        datasets: [{

                            data:
                                expenseData.map(
                                    item => item.count
                                ),

                            backgroundColor: [

                                '#4F46E5',

                                '#16A34A',

                                '#F59E0B',

                                '#DC2626'

                            ],

                            borderWidth:
                                0

                        }]

                    },


                    options: {

                        responsive:
                            true,

                        maintainAspectRatio:
                            false,

                        cutout:
                            '65%',


                        plugins: {

                            legend: {

                                position:
                                    'bottom'

                            }

                        }

                    }

                }
            );

        }


    }
);

</script>


</body>

</html>
