<%- include('../partials/layout-head') %>
<div class="app">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <div class="page-header">
      <h1>Submit Expense Claim</h1>
    </div>
    <% (error || []).forEach(function(msg) { %>
      <div class="alert alert-error"><%= msg %></div>
    <% }) %>
    <div class="card">
      <form method="POST" action="/expenses/new">
        <div class="form-row">
          <div class="form-group">
            <label>Category *</label>
            <select name="category" required>
              <option value="">— Select —</option>
              <% categories.forEach(function(c) { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Project (optional)</label>
            <select name="project_id">
              <option value="">— None —</option>
              <% projects.forEach(function(p) { %>
                <option value="<%= p.id %>"><%= p.code %> – <%= p.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Amount *</label>
            <input type="number" name="amount" step="0.01" min="0.01" required>
          </div>
          <div class="form-group">
            <label>Currency</label>
            <select name="currency">
              <% ['INR', 'USD', 'EUR', 'GBP'].forEach(function(c) { %>
                <option value="<%= c %>" <%= c === 'INR' ? 'selected' : '' %>><%= c %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Expense date *</label>
          <input type="date" name="expense_date" required>
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="3" placeholder="What was this for?"></textarea>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn" type="submit">Submit claim</button>
          <a href="/expenses" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>
</body></html>
