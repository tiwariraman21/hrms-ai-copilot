<%- include('../partials/layout-head') %>
<div class="app">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <div class="page-header">
      <h1>My Attendance</h1>
    </div>
    <%- include('../partials/flash') %>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="label">Days present this month</div>
        <div class="value"><%= monthly.days_present || 0 %></div>
      </div>
      <div class="stat-card">
        <div class="label">Days fully logged</div>
        <div class="value"><%= monthly.days_completed || 0 %></div>
      </div>
    </div>

    <div class="card flex-between">
      <div>
        <% if (today && today.clock_in) { %>
          <p>Clocked in at <strong><%= today.clock_in %></strong><% if (today.clock_out) { %>, out at <strong><%= today.clock_out %></strong><% } %>.</p>
        <% } else { %>
          <p class="muted">You haven't clocked in today.</p>
        <% } %>
      </div>
      <div style="display: flex; gap: 8px;">
        <form method="POST" action="/attendance/clock-in">
          <button class="btn btn-success" <%= today && today.clock_in ? 'disabled' : '' %>>Clock in</button>
        </form>
        <form method="POST" action="/attendance/clock-out">
          <button class="btn btn-secondary" <%= !today || !today.clock_in || today.clock_out ? 'disabled' : '' %>>Clock out</button>
        </form>
      </div>
    </div>

    <div class="card">
      <h2>Recent records</h2>
      <% if (records.length === 0) { %>
        <p class="empty">No attendance records yet.</p>
      <% } else { %>
        <table>
          <thead>
            <tr><th>Date</th><th>Clock in</th><th>Clock out</th></tr>
          </thead>
          <tbody>
            <% records.forEach(function(r) { %>
              <tr>
                <td><%= r.date %></td>
                <td><%= r.clock_in || '—' %></td>
                <td><%= r.clock_out || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>
</body></html>
