<%- include('../partials/layout-head') %>
<div class="app">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <div class="page-header">
      <h1>All Attendance</h1>
    </div>
    <% if (rows.length === 0) { %>
      <div class="card empty">No records.</div>
    <% } else { %>
      <table>
        <thead>
          <tr><th>Date</th><th>Employee</th><th>Department</th><th>Clock in</th><th>Clock out</th></tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r) { %>
            <tr>
              <td><%= r.date %></td>
              <td><%= r.name %></td>
              <td><%= r.department || '—' %></td>
              <td><%= r.clock_in || '—' %></td>
              <td><%= r.clock_out || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</div>
</body></html>
